// Serves the sample-only build in dist/ as static assets. Cloudflare builds it
// from GitHub, where local.ts never exists; never `wrangler deploy` from a
// machine that has the private profile.
{
  "name": "fiscal-compass",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
